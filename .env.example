# The connected Mana Proddatur project is the default; no overrides are required.
# Optional project overrides: set BOTH values at build time.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Use only the public sb_publishable_ key. Never put a service-role/secret key here.
# Set to demo for fictional sample shops and local editing; live is the default.
VITE_DIRECTORY_MODE=live
